MONGO_URI=mongodb://localhost:27017/secure-case
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30m
IO_PIN_HASH=generate-with-bcrypt
LO_PIN_HASH=generate-with-bcrypt
ADMIN_PIN_HASH=generate-with-bcrypt
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
FORCE_DNS_SERVERS=

# Hybrid AI (cloud-first): Gemini is tried first when a key is set,
# then Ollama cloud models, then the local Ollama model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_CLOUD_MODEL=deepseek-v4-flash:cloud
