MONGO_URI=mongodb://localhost:27017/secure-case
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30m
IO_PIN_HASH=generate-with-bcrypt
LO_PIN_HASH=generate-with-bcrypt
ADMIN_PIN_HASH=generate-with-bcrypt
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
FORCE_DNS_SERVERS=

# Set to 1 to enable role quick-login (demo only). Leave unset in production.
DEMO_LOGIN=

# Hybrid AI: Gemini is the fast first-pass provider. On quota/5xx/timeout
# failure it falls back to Ollama Cloud (e.g. Nemotron), then (dev only) to a
# local Ollama daemon. Never expose these keys to the frontend.
AI_PROVIDER=hybrid
GEMINI_API_KEY=
# Fast model measured at ~3.4s for a ~24K-char legal payload.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT_MS=15000
# Bump when the prompt/model schema changes so stale cached analyses regenerate.
AI_ANALYSIS_VERSION=fast-v1

# Ollama Cloud fallback (Nemotron). OLLAMA_API_KEY is a secret: Render env var
# only, never committed. OLLAMA_LOCAL=0 disables the local-daemon fallback in
# production (no Ollama daemon exists on Render).
OLLAMA_API_KEY=
OLLAMA_MODEL=nemotron:cloud
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_TIMEOUT_MS=45000
OLLAMA_LOCAL=0
OLLAMA_URL=http://localhost:11434
